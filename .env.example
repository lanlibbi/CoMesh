# GPU-Pool POC environment

# --- Ollama (LLM backend) ---
OLLAMA_URL=http://host.docker.internal:11434
DEFAULT_MODEL=qwen2.5-coder:7b

# --- App ---
APP_PUBLIC_URL=http://100.126.79.111:8765
COST_PER_1K_TOKENS=0.001
DATA_DIR=/data
DOCKER_ENV=1

# --- Auth (see docs/auth.md) ---
# Long-lived API keys: 0 = never expire.
API_KEY_TTL_DAYS=0
# TTL of the session token issued by /auth/login.
SESSION_TOKEN_TTL_HOURS=24
AUTH_PBKDF2_ITERATIONS=240000
MIN_PASSWORD_LENGTH=8
# Admin endpoints (/admin/users, /admin/users/{id}/topup) are default-deny.
# Set at least one of these, otherwise every admin call returns 401.
ADMIN_TOKEN=
ADMIN_EMAILS=
# Explicit POC escape hatch: 1 disables admin authentication. Do not use on a
# reachable deployment - it is logged per request.
ADMIN_AUTH_DISABLED=0
# Seed test account password (only used when the DB is empty on first start).
SEED_PASSWORD=
# Rate limits (token bucket: sustained per-minute / burst).
RATE_LIMITS_DISABLED=0
RATE_LIMIT_CHAT_PER_MIN=60
RATE_LIMIT_CHAT_BURST=20
RATE_LIMIT_CHAT_IP_PER_MIN=120
RATE_LIMIT_CHAT_IP_BURST=40
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_LOGIN_BURST=5
RATE_LIMIT_REGISTER_PER_MIN=30
RATE_LIMIT_REGISTER_BURST=10
RATE_LIMIT_NODE_PER_MIN=240
RATE_LIMIT_NODE_BURST=60
RATE_LIMIT_ADMIN_PER_MIN=30
RATE_LIMIT_ADMIN_BURST=5
# Login brute-force lockout.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=300
LOGIN_LOCK_MAX_SECONDS=3600
# Set to 1 only when the portal really sits behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=0

# --- Stripe (TEST MODE) ---
# Get keys at https://dashboard.stripe.com/test/apikeys
# Leave blank to run in mock mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal (SANDBOX) ---
# Get sandbox credentials at https://developer.paypal.com/dashboard/
# Leave blank to run in mock mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# --- Alipay + Apple Pay ---
# These are routed through Stripe in this POC.
# Add an Apple Pay domain in your Stripe dashboard before going live.
