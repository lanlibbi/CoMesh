# GPU-Pool POC environment

# --- Ollama (LLM backend) ---
OLLAMA_URL=http://host.docker.internal:11434
DEFAULT_MODEL=qwen2.5-coder:7b

# --- App ---
APP_PUBLIC_URL=http://100.126.79.111:8765
COST_PER_1K_TOKENS=0.001
DATA_DIR=/data
DOCKER_ENV=1

# --- Admin bootstrap (REQUIRED to reach /admin/*) ---
# The key installed for the admin user at startup. Generate one, e.g.
#   python3 -c "import secrets;print('gpu_'+secrets.token_urlsafe(32))"
# and keep it out of version control.
ADMIN_API_KEY=
ADMIN_EMAIL=admin@gpu-pool.local
ADMIN_NAME=Platform Admin
# Optional fallback when ADMIN_API_KEY is unset: promote THIS existing account
# to role 'admin' at startup. Off by default (empty) so a deployment never
# silently grants admin to a seeded/POC account. Set it to the account's email.
PROMOTE_ADMIN_EMAIL=

# --- Stripe (TEST MODE) ---
# Get keys at https://dashboard.stripe.com/test/apikeys
# Leave blank to run in mock mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal (SANDBOX) ---
# Get sandbox credentials at https://developer.paypal.com/dashboard/
# Leave blank to run in mock mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# --- Alipay + Apple Pay ---
# These are routed through Stripe in this POC.
# Add an Apple Pay domain in your Stripe dashboard before going live.

# Credits feature flag (LANA-56)
CREDITS_ENABLED=
CONFIG_PATH=
