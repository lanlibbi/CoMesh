# GPU-Pool POC environment

# --- Ollama (LLM backend) ---
OLLAMA_URL=http://host.docker.internal:11434
DEFAULT_MODEL=qwen2.5-coder:7b

# --- App ---
# Public base URL of this portal. Only needed when payment providers are
# configured (they redirect the buyer back here). Left empty, the portal derives
# it from the request that started the checkout — that keeps a fresh installation
# on DHCP working without configuring anything.
# Use a DNS/mDNS name rather than an IP: an IP breaks when the lease changes.
# APP_PUBLIC_URL=http://portal-host:8765
COST_PER_1K_TOKENS=0.001
DATA_DIR=/data
DOCKER_ENV=1

# --- Published ports ---
# Both published ports bind to 127.0.0.1 unless told otherwise, so a fresh
# installation answers on the machine it runs on and nowhere else:
#   8767  portal UI (nginx)      8765  API (FastAPI)
COMESH_BIND_ADDRESS=127.0.0.1
COMESH_API_BIND_ADDRESS=127.0.0.1
#
# When you need 0.0.0.0:
#   - a tunnel (e.g. cloudflared) that runs on this host but dials the host's
#     LAN address instead of 127.0.0.1,
#   - a reverse proxy in another container, VM or machine,
#   - browsers or OpenAI-compatible clients on other machines in your LAN.
#
# WARNING: 0.0.0.0 publishes the application on every interface. Whoever can
# reach the port then talks to CoMesh directly — past any proxy, tunnel, TLS
# termination or access rule in front of it. Binding to a tunnel or proxy is
# only safe while that proxy is the only way in and a firewall keeps the port
# closed from everywhere else.
#
# You normally do not need COMESH_API_BIND_ADDRESS at all: the nginx in the
# frontend container reaches the API as http://api:8000 over the Compose
# network and serves it on port 8767 as /v1/... and /api/v1/.... A node-agent
# on another machine is the exception — registration and heartbeat also work
# under http://<portal>:8767/api, but the shipped nginx does not forward the
# agent WebSocket (/agent/connect), so remote nodes usually need the API port
# published on an address they can reach.

# --- Admin bootstrap (REQUIRED to reach /admin/*) ---
# Leave this empty and the portal generates a key at install time, stores it in
# $DATA_DIR/admin_api_key.txt (chmod 600) and reuses it on every later start, so a
# fresh install has a working admin console without anyone hand-crafting a secret.
# Set it to take over explicitly (e.g. to keep the secret out of the data volume):
#   python3 -c "import secrets;print('gpu_admin_'+secrets.token_urlsafe(32))"
# and keep it out of version control.
ADMIN_API_KEY=
ADMIN_EMAIL=admin@gpu-pool.local
ADMIN_NAME=Platform Admin
# Optional fallback when ADMIN_API_KEY is unset: promote THIS existing account
# to role 'admin' at startup. Off by default (empty) so a deployment never
# silently grants admin to a seeded/POC account. Set it to the account's email.
PROMOTE_ADMIN_EMAIL=

# --- Stripe (TEST MODE) ---
# Get keys at https://dashboard.stripe.com/test/apikeys
# Leave blank to run in mock mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal (SANDBOX) ---
# Get sandbox credentials at https://developer.paypal.com/dashboard/
# Leave blank to run in mock mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# --- Alipay + Apple Pay ---
# These are routed through Stripe in this POC.
# Add an Apple Pay domain in your Stripe dashboard before going live.

# Credits feature flag (LANA-56)
CREDITS_ENABLED=
CONFIG_PATH=

# --- node-agent (LANA-132) ---
# Credentials of the local node this portal hosts (issued by POST /nodes/register).
# docker-compose.yml reads them for the `node-agent` service; keep the real values
# in .env (git-ignored), never here.
NODE_ID=1
NODE_API_KEY=
